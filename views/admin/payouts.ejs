<%- include('../partials/admin-header', { activePage: 'admin-payouts' }) %>

<style>
  /* The statement is handed to the therapist, who reads Chinese. Keep the
     Chinese on its own line under the English rather than inline, so neither
     language is squeezed. */
  .zh { display:block; font-size:.85rem; color:#666; font-weight:400; margin-top:.1rem; }
  @media print {
    .admin-header, .no-print, form { display:none !important; }
    .card { border:none !important; box-shadow:none !important; page-break-inside:avoid; }
  }
</style>
<main class="admin-main">
  <div class="container">
    <h1>Therapist Payouts</h1>
    <p class="muted" style="margin-bottom:1.2rem;">
      Therapists keep <strong>all tips</strong> and receive their share of service revenue.
      <strong>Cash tips are already in their pocket</strong> — shown here for the record only.
      <strong>Card tips were collected by the spa and are owed.</strong>
    </p>

    <% if (saved) { %>
    <div class="admin-alert" style="background:#e8f5e9; border:1px solid #a5d6a7; color:#2e7d32; border-radius:12px; padding:.8rem 1rem; margin-bottom:1.2rem; font-weight:600;">
      ✓ Payout recorded.
    </div>
    <% } %>

    <div class="card" style="margin-bottom:1.5rem;">
      <form class="form" method="GET" action="/admin/payouts">
        <div class="grid two">
          <label>Therapist
            <select name="therapist_id" required>
              <option value="">— Choose —</option>
              <% therapists.forEach(function(t){ %>
              <option value="<%= t.id %>" <%= therapistId === t.id ? 'selected' : '' %>><%= t.name %></option>
              <% }); %>
            </select>
          </label>
          <label>Split
            <input type="text" value="<%= summary ? summary.commissionPercent + '% to therapist' : 'set on the therapist' %>" disabled />
          </label>
        </div>
        <div class="grid two">
          <label>From<input type="date" name="start" value="<%= startDate %>" required /></label>
          <label>To<input type="date" name="end" value="<%= endDate %>" required /></label>
        </div>
        <button class="btn btn-primary" type="submit">Show payout</button>
      </form>
    </div>

    <% if (summary) { %>
    <div class="card" style="margin-bottom:1.5rem;">
      <h2><%= summary.therapist.name %> — <%= fmt.prettyDate(startDate) %> to <%= fmt.prettyDate(endDate) %></h2>

      <table class="admin-table" style="margin-top:1rem;">
        <tbody>
          <tr><td>Sessions <span class="zh">服务次数</span></td><td style="text-align:right;"><strong><%= summary.sessions %></strong></td></tr>
          <tr><td>Service revenue collected <span class="zh">服务收入合计</span></td><td style="text-align:right;"><%= fmt.money(summary.serviceTotal) %></td></tr>
          <tr style="background:#f6faf9;">
            <td><strong>Their share (<%= summary.commissionPercent %>%)</strong> <span class="zh">按摩师分成</span></td>
            <td style="text-align:right;"><strong><%= fmt.money(summary.serviceShare) %></strong></td>
          </tr>
          <tr>
            <td>Cash tips <span class="muted small">— already taken, not paid here</span> <span class="zh">现金小费 — 已收到，此处不再支付</span></td>
            <td style="text-align:right; color:#888;"><%= fmt.money(summary.cashTips) %></td>
          </tr>
          <tr style="background:#f6faf9;">
            <td><strong>Card tips</strong> <span class="muted small">— owed</span> <span class="zh">刷卡小费 — 应付</span></td>
            <td style="text-align:right;"><strong><%= fmt.money(summary.cardTips) %></strong></td>
          </tr>
          <% if (summary.rentDeduction > 0) { %>
          <tr>
            <td>Housing rent <span class="muted small">— <%= summary.housingStatus %>, <%= fmt.money(summary.rentMonthly) %>/mo × <%= summary.periodDays %> days</span> <span class="zh">住宿费 — 按天计算</span></td>
            <td style="text-align:right; color:#b02a37;">− <%= fmt.money(summary.rentDeduction) %></td>
          </tr>
          <% } %>
          <tr style="border-top:3px solid var(--brand);">
            <td style="font-size:1.25rem;"><strong>TOTAL TO PAY 应付</strong></td>
            <td style="text-align:right; font-size:1.5rem; color:var(--brand);"><strong><%= fmt.money(summary.totalOwed) %></strong></td>
          </tr>
        </tbody>
      </table>

      <%# Lead with the keyboard shortcut. A JS print button does nothing in a
          preview pane or a sandboxed frame, and one that silently fails is
          worse than none — the staff would just tap it again. %>
      <p class="no-print muted small" style="margin-top:1rem;">
        To print: press <kbd style="background:#fff;border:1px solid #bbb;border-bottom-width:2px;border-radius:4px;padding:.05rem .35rem;">⌘</kbd>+<kbd style="background:#fff;border:1px solid #bbb;border-bottom-width:2px;border-radius:4px;padding:.05rem .35rem;">P</kbd>
        (or <kbd style="background:#fff;border:1px solid #bbb;border-bottom-width:2px;border-radius:4px;padding:.05rem .35rem;">Ctrl</kbd>+<kbd style="background:#fff;border:1px solid #bbb;border-bottom-width:2px;border-radius:4px;padding:.05rem .35rem;">P</kbd> on Windows).
        <span class="zh">打印：按 ⌘+P（Windows 用 Ctrl+P）</span>
      </p>
      <button type="button" class="btn btn-ghost no-print" onclick="window.print()" style="margin-top:.4rem;">
        🖨 Print this statement 打印结算单
      </button>

      <form method="POST" action="/admin/payouts" style="margin-top:1.2rem;"
            onsubmit="return confirm('Record a payout of <%= fmt.money(summary.totalOwed) %> to <%= summary.therapist.name %>?')">
        <input type="hidden" name="therapist_id" value="<%= therapistId %>" />
        <input type="hidden" name="start" value="<%= startDate %>" />
        <input type="hidden" name="end" value="<%= endDate %>" />
        <label>Notes <span class="muted small">(optional)</span>
          <input type="text" name="notes" placeholder="e.g. paid by check #1042, or final payout on departure" />
        </label>
        <button class="btn btn-primary" type="submit">Record this payout</button>
      </form>
    </div>

    <div class="card" style="margin-bottom:1.5rem;">
      <h2>Sessions in this period (<%= summary.lines.length %>)</h2>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead><tr><th>Date</th><th>Time</th><th>Client</th><th>Service</th>
            <th style="text-align:right;">Collected</th><th style="text-align:right;">Credited</th>
            <th style="text-align:right;">Tip</th></tr></thead>
          <tbody>
            <% summary.lines.forEach(function(l){ %>
            <tr>
              <td><%= fmt.shortDate(l.date) %></td>
              <td><%= fmt.prettyTime(l.time) %></td>
              <td><%= l.client %></td>
              <td><%= l.service %><% if (l.hands > 1) { %> <span class="muted small">(2 therapists — split)</span><% } %></td>
              <td style="text-align:right;"><%= fmt.money(l.gross) %></td>
              <td style="text-align:right;"><%= fmt.money(l.mine) %></td>
              <td style="text-align:right;"><%= fmt.money(l.tip) %>
                <span class="muted small"><%= l.tipMethod === 'cash' ? 'cash' : 'card' %></span></td>
            </tr>
            <% }); %>
            <% if (summary.lines.length === 0) { %>
            <tr><td colspan="7" class="muted">No completed sessions in this period.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <div class="card">
      <h2>Payout history</h2>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead><tr><th>Paid</th><% if (!therapistId) { %><th>Therapist</th><% } %>
            <th>Period</th><th style="text-align:right;">Service share</th>
            <th style="text-align:right;">Card tips</th><th style="text-align:right;">Total</th><th>Notes</th></tr></thead>
          <tbody>
            <% history.forEach(function(h){ %>
            <tr>
              <td><%= (h.paid_at || '').slice(0,10) %></td>
              <% if (!therapistId) { %><td><%= h.therapist_name || '' %></td><% } %>
              <td><%= fmt.shortDate(h.period_start) %> – <%= fmt.shortDate(h.period_end) %></td>
              <td style="text-align:right;"><%= fmt.money(h.service_share) %></td>
              <td style="text-align:right;"><%= fmt.money(h.card_tips) %></td>
              <td style="text-align:right;"><strong><%= fmt.money(h.total_paid) %></strong></td>
              <td class="muted small"><%= h.notes %></td>
            </tr>
            <% }); %>
            <% if (history.length === 0) { %>
            <tr><td colspan="<%= therapistId ? 6 : 7 %>" class="muted">No payouts recorded yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

</body>
</html>
