<%- include('partials/header', {
  title: 'Manage Booking | J&M Serenity Spa',
  description: 'Cancel or reschedule your appointment.',
  activePage: 'book'
}) %>

<%
  /* Status handling. `booking.status` is the source of truth; the `cancelled` /
     `rescheduled` locals are just "you did that a second ago" flashes after a
     POST redirect. Both are read defensively so this page renders whether or
     not the route passes them. */
  var b = (typeof booking !== 'undefined' && booking) ? booking : null;
  var status = b ? String(b.status || '') : '';
  var isCancelled = status === 'cancelled' || (typeof cancelled !== 'undefined' && cancelled);
  var justRescheduled = (typeof rescheduled !== 'undefined' && rescheduled);
  var isFinished = status === 'completed' || status === 'no_show';
  // Anything that isn't cancelled or already over can still be moved or dropped.
  var isActionable = !isCancelled && !isFinished;
%>

<main>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow reveal">My Booking</p>
      <h1 class="reveal">Your Appointment</h1>
    </div>
  </section>

  <section class="section">
    <div class="container content" style="max-width: 640px;">
      <% if (!b) { %>
      <div class="card reveal">
        <h2>We couldn't find that appointment</h2>
        <p class="muted"><%= (typeof error !== 'undefined' && error) ? error : "This link doesn't match a booking. It may have already been cancelled." %></p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/book">Book a New Appointment</a>
        </div>
      </div>
      <% } else { %>

        <% if (justRescheduled) { %>
        <div class="callout reveal" style="background: #d4edda; border-color: #c3e6cb; margin-bottom: 1.5rem;">
          <p style="color: #155724; font-weight: 600; margin: 0;">
            Done — your appointment is now <%= fmt.dateTime(b.date, b.time) %>.
          </p>
        </div>
        <% } %>

        <% if (isCancelled) { %>
        <!-- Cancelled is a real, final state and it says so plainly. Nothing on
             this page should still look actionable once it's cancelled. -->
        <div class="callout reveal" style="background: #f8d7da; border-color: #f5c6cb; margin-bottom: 1.5rem;">
          <p style="color: #721c24; font-weight: 700; margin: 0 0 .25rem;">This appointment is cancelled.</p>
          <p style="color: #721c24; margin: 0;">
            Nothing is booked for you, and there is nothing to pay.
          </p>
        </div>
        <% } %>

        <div class="card reveal">
          <h2><%= isCancelled ? 'The cancelled appointment' : 'Appointment details' %></h2>
          <ul class="contact-list">
            <li><strong>When:</strong> <%= fmt.dateTime(b.date, b.time) %></li>
            <li><strong>Treatment:</strong> <%= b.service_name %> (<%= fmt.prettyDuration(b.duration) %>)</li>
            <li><strong>Therapist:</strong> <%= b.therapist_name || 'Assigned when you arrive' %></li>
            <%# A nameless booking is stored with the phone number as the name. %>
            <% if (b.client_name && b.client_name !== b.client_phone) { %>
            <li><strong>Name:</strong> <%= b.client_name %></li>
            <% } %>
          </ul>
          <% if (isActionable) { %>
          <p class="muted" style="margin-top: .8rem;">Pay in person after your appointment. We don't take payment online.</p>
          <% } %>
        </div>

        <% if (isCancelled) { %>
        <div class="cta-row reveal" style="margin-top: 1rem;">
          <a class="btn btn-primary" href="/book">Book a New Appointment</a>
          <a class="btn btn-ghost" href="/">Back to Home</a>
        </div>

        <% } else if (isFinished) { %>
        <div class="card reveal" style="margin-top: 1rem;">
          <h2>This appointment has already happened</h2>
          <p class="muted">Thank you for visiting us. We'd love to see you again.</p>
          <div class="cta-row">
            <a class="btn btn-primary" href="/book">Book Again</a>
          </div>
        </div>

        <% } else { %>

        <!-- Reschedule. The new time comes from the same availability picker the
             booking form uses, so a client can only move into a slot that is
             genuinely open — not 3am, and not on top of someone else. -->
        <div class="card reveal" style="margin-top: 1rem;">
          <h2>Move it to another time</h2>
          <% if (typeof rescheduleError !== 'undefined' && rescheduleError) { %>
          <div class="callout" role="alert" style="background:#fdecea; border:1px solid #f5c6cb; border-radius:12px; padding:.85rem 1rem; margin-bottom:1rem;">
            <p style="color:#b02a37; margin:0; font-weight:600;"><%= rescheduleError %></p>
          </div>
          <% } %>

          <form class="form" method="POST" action="/booking/reschedule/<%= b.cancel_token %>">

            <!-- Feeds the shared slot picker in /script.js. Disabled: the
                 treatment and therapist stay as booked, only the time moves. -->
            <select id="service-select" disabled hidden aria-hidden="true" tabindex="-1">
              <option value="<%= b.service_id %>" data-duration="<%= b.duration %>" data-category="<%= b.service_category || '' %>" selected></option>
            </select>
            <% if (b.therapist_id) { %>
            <select id="therapist-select" disabled hidden aria-hidden="true" tabindex="-1">
              <option value="<%= b.therapist_id %>" selected></option>
            </select>
            <% } %>

            <label>
              New date
              <input type="date" name="date" id="date-input" value="<%= b.date %>" required />
            </label>

            <div id="slots-container" style="display:none;">
              <p class="small" style="font-weight:700; margin-bottom:.5rem;">New time</p>
              <div id="slots-grid" class="slots-grid" aria-live="polite"></div>
              <input type="hidden" name="time" id="time-input" />
            </div>

            <noscript>
              <label>
                New time
                <%# No name= here: the hidden #time-input above already posts "time".
                   Two fields with the same name post an array. script.js copies
                   this value across for the no-JS path. %>
                <input type="time" id="time-fallback" value="<%= b.time %>" required
                  onchange="var h=document.getElementById('time-input'); if(h) h.value=this.value;" />
              </label>
            </noscript>

            <button class="btn btn-primary" type="submit" id="submit-btn"
                    data-ready-label="Move my appointment"
                    data-waiting-label="Pick a new time">
              Move my appointment
            </button>
          </form>
        </div>

        <!-- Cancel. Kept visually quieter than rescheduling, but not hidden:
             burying it is how you end up with no-shows. -->
        <div class="card reveal" style="margin-top: 1rem;">
          <h2>Cancel this appointment</h2>
          <p class="muted">
            Please give us at least 24 hours' notice so we can offer the time to someone else.
          </p>
          <form method="POST" action="/booking/cancel/<%= b.cancel_token %>"
                onsubmit="return confirm('Cancel this appointment? This cannot be undone.')">
            <button class="btn btn-ghost" type="submit" style="color: #c0392b; border-color: #c0392b; margin-top: .8rem;">
              Cancel my appointment
            </button>
          </form>
        </div>

        <!-- Directions only. The phone number is in the footer of every page;
             repeating it next to "need something else?" invites calls to a desk
             that cannot take them in English. -->
        <div class="card reveal" style="margin-top: 1rem;">
          <h2>Before you come in</h2>
          <ul class="contact-list">
            <% if (settings.address) { %>
            <li>
              <strong>Find us:</strong>
              <a href="https://maps.google.com/?q=<%= encodeURIComponent(settings.address) %>" target="_blank" rel="noopener">
                <%= settings.address %>
              </a>
            </li>
            <% } %>
            <li><strong>Parking:</strong> Free parking directly in front of the suite.</li>
            <li><strong>Arrival:</strong> Please arrive 5–10 minutes early.</li>
          </ul>
        </div>

        <div class="cta-row reveal" style="margin-top: 1rem;">
          <a class="btn btn-ghost" href="/">Back to Home</a>
        </div>

        <% } %>
      <% } %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
