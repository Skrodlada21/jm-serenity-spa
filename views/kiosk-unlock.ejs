<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Set Up This Device — J&amp;M Serenity Spa</title>
  <link rel="icon" type="image/png" href="<%= asset('/images/favicon-32.png') %>" sizes="32x32" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: linear-gradient(160deg, #1f6f78, #114a50);
      color: #fff; min-height: 100vh;
      display: flex; align-items: center; justify-content: center; padding: 1.5rem;
    }
    .card {
      background: rgba(255,255,255,.08);
      border: 1px solid rgba(255,255,255,.18);
      border-radius: 20px; padding: 2.2rem 2rem;
      width: 100%; max-width: 420px; text-align: center;
      backdrop-filter: blur(8px);
    }
    .logo { width: 72px; height: 72px; border-radius: 50%; object-fit: cover;
            border: 2px solid rgba(201,169,110,.6); margin-bottom: 1.2rem; }
    h1 { font-size: 1.4rem; font-weight: 600; margin-bottom: .5rem; }
    p.sub { color: rgba(255,255,255,.75); font-size: .95rem; line-height: 1.5; margin-bottom: 1.5rem; }
    input[type="password"] {
      width: 100%; font-size: 1.6rem; text-align: center; letter-spacing: .3em;
      padding: .9rem; border-radius: 12px; border: 1.5px solid rgba(255,255,255,.3);
      background: rgba(0,0,0,.2); color: #fff; margin-bottom: 1rem;
    }
    input[type="password"]:focus { outline: none; border-color: #c9a96e; }
    button {
      width: 100%; font-size: 1.1rem; font-weight: 600; padding: .95rem;
      border: none; border-radius: 12px; background: #c9a96e; color: #114a50;
      cursor: pointer;
    }
    button:hover { background: #e8d5b0; }
    .err { background: rgba(220,53,69,.25); border: 1px solid rgba(255,255,255,.25);
           border-radius: 10px; padding: .6rem .8rem; margin-bottom: 1rem; font-size: .95rem; }
    .note { margin-top: 1.4rem; font-size: .8rem; color: rgba(255,255,255,.5); line-height: 1.5; }
  </style>
</head>
<body>
  <div class="card">
    <img src="<%= asset('/images/logo.png') %>" alt="J&amp;M Serenity Spa" class="logo" />
    <h1>Set Up This Device</h1>
    <p class="sub">
      This tablet needs to be set up once for guest check-in.<br />
      A staff member enters the front desk PIN.
    </p>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="err"><%= error %></div>
    <% } %>

    <form method="POST" action="/kiosk/unlock">
      <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '/arrive' %>" />
      <input type="password" name="password" inputmode="numeric" autocomplete="off"
             placeholder="PIN" autofocus required />
      <button type="submit">Set Up Device</button>
    </form>

    <p class="note">
      员工：请输入前台密码以设置此设备。<br />
      Guests do not need to do this — please ask our front desk.
    </p>
  </div>
</body>
</html>
