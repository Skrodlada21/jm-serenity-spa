<%- include('partials/header', {
  title: 'Contact | J&M Serenity Spa',
  description: 'Contact J&M Serenity Spa with questions about our Signature Treatments or booking.',
  activePage: 'contact'
}) %>

<%
  /* settings.phone is stored pretty, e.g. "(303) 500-5845". A tel: URI must not
     contain parentheses or spaces, so strip to digits and build E.164:
     10 digits => prefix +1; 11 digits starting with 1 => already country-coded.
     Anything else yields '' so we never render a broken "tel:+1". */
  var contactPhoneDigits = String(settings.phone || '').replace(/\D/g, '');
  var contactPhoneHref = '';
  if (contactPhoneDigits.length === 10) {
    contactPhoneHref = '+1' + contactPhoneDigits;
  } else if (contactPhoneDigits.length === 11 && contactPhoneDigits.charAt(0) === '1') {
    contactPhoneHref = '+' + contactPhoneDigits;
  }

  /* Hours: read from settings, rendered human-readable ("09:00" -> "9am") so the
     contact card matches the hours shown in the footer. */
  function contactTime(value, fallback) {
    var m = /^(\d{1,2}):(\d{2})$/.exec(String(value || ''));
    if (!m) return fallback;
    var h = parseInt(m[1], 10);
    var mins = m[2];
    if (isNaN(h) || h > 23) return fallback;
    var suffix = h >= 12 ? 'pm' : 'am';
    var hour12 = (h % 12) || 12;
    return (mins === '00' ? String(hour12) : hour12 + ':' + mins) + suffix;
  }
  var contactOpen = contactTime(settings.open_time, '9am');
  var contactClose = contactTime(settings.close_time, '7pm');
%>

<main>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow reveal">Contact</p>
      <h1 class="reveal">Get in Touch</h1>
      <p class="lead muted reveal" style="max-width: 70ch;">
        Have questions about our treatments or want to book by phone? We're happy to help.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container content">
      <div class="grid two">
        <div class="card reveal">
          <h2>Contact Info</h2>
          <ul class="contact-list">
            <li><strong>Phone:</strong>
              <% if (contactPhoneHref) { %>
                <a href="tel:<%= contactPhoneHref %>"><%= settings.phone %></a>
              <% } else { %>
                <%= settings.phone || '[Your Phone]' %>
              <% } %>
            </li>
            <li><strong>Email:</strong> <a href="mailto:<%= settings.email || '' %>"><%= settings.email || '[Your Email]' %></a></li>
            <li><strong>Hours:</strong> Mon–Sat <%= contactOpen %>–<%= contactClose %> · Closed Sunday</li>
            <li><strong>Location:</strong> <%= settings.address || 'Littleton, CO' %></li>
          </ul>

          <div class="cta-row">
            <a class="btn btn-primary" href="/book">Book Online</a>
            <a class="btn btn-ghost" href="/treatments">View Treatments</a>
          </div>
        </div>

        <div class="card reveal">
          <h2>Send a Message</h2>
          <form class="form" method="POST" action="/contact">
            <label>
              Name
              <input type="text" name="name" placeholder="Your name" required />
            </label>
            <label>
              Email
              <input type="email" name="email" placeholder="you@example.com" required />
            </label>
            <label>
              Message
              <textarea name="message" rows="6" placeholder="How can we help?" required></textarea>
            </label>
            <button class="btn btn-primary" type="submit">Send</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <% if (settings.google_maps_embed) { %>
  <section class="section alt">
    <div class="container">
      <h2 class="reveal" style="margin-bottom: 1rem;">Find Us</h2>
      <div class="reveal" style="border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line);">
        <iframe src="<%= settings.google_maps_embed %>" width="100%" height="400" style="border:0; display:block;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
  <% } %>
</main>

<%- include('partials/footer') %>
