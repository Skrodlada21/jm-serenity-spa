<%- include('partials/header', {
  title: 'Book | J&M Serenity Spa',
  description: 'Book online with J&M Serenity Spa. Choose your treatment and pick a time — no payment online.',
  activePage: 'book'
}) %>

<main>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow reveal">Booking</p>
      <h1 class="reveal">Book a Signature Treatment</h1>
      <p class="lead muted reveal" style="max-width: 70ch;">
        Choose a treatment, pick a time, and leave a phone number. That's it —
        no payment online. You pay at the spa after your session.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container content">
      <div class="card reveal">
        <h2>Schedule Your Appointment</h2>

        <% if (typeof bookingError !== 'undefined' && bookingError) { %>
        <div class="admin-alert" style="background:#fdecea; border:1px solid #f5c6cb; color:#b02a37; border-radius:12px; padding:.85rem 1rem; margin-bottom:1rem;">
          <% if (bookingError === 'slot_taken') { %>
            <strong>Sorry — that time was just booked.</strong><br />
            Someone else took it while you were filling out the form. Please pick another time below.
          <% } else if (bookingError === 'invalid_time') { %>
            <strong>Please choose a date and a time.</strong><br />
            Pick your service first, then a date, then tap one of the available times.
          <% } else { %>
            <strong>Sorry, something went wrong.</strong><br />
            Please check your details and try again, or call us at <%= settings.phone || '' %>.
          <% } %>
        </div>
        <% } %>

        <% if (typeof waitlisted !== 'undefined' && waitlisted) { %>
        <div class="admin-alert" style="background:#e8f5e9; border:1px solid #a5d6a7; color:#2e7d32; border-radius:12px; padding:.85rem 1rem; margin-bottom:1rem;">
          <strong>You're on the waitlist.</strong><br />
          We'll call you if that time opens up. You can also book an available time below.
        </div>
        <% } %>

        <form class="form" method="POST" action="/book" id="booking-form">

          <!-- 1) Service ----------------------------------------------------
               Service comes first: it decides the duration, and therefore which
               times are even available. -->
          <label>
            <span class="step-label"><span class="step-num">1</span> Choose your treatment</span>
            <select name="service_id" id="service-select" required>
              <option value="">— Choose a service —</option>
              <% services.forEach(function(svc) { %>
              <option value="<%= svc.id %>"
                data-duration="<%= svc.duration %>"
                data-category="<%= svc.category %>"
                <%= preselect == svc.id ? 'selected' : '' %>>
                <%# Some services (Water Head Massage) have no price set — never quote one. %>
                <%= svc.name %> — <%= fmt.prettyDuration(svc.duration) %><%= Number(svc.price) > 0 ? ' · ' + fmt.money(svc.price) : '' %>
              </option>
              <% }); %>
            </select>
          </label>

          <!-- Therapist preferences are optional and deliberately secondary:
               most clients have none, and every extra visible field is another
               question the front desk may be asked to explain in English.
               Opened automatically when the client arrived from a "Book with
               <name>" link, or when a Four Hands service needs a 2nd therapist. -->
          <details class="booking-prefs" id="prefs-details" <%= (typeof preselectTherapist !== 'undefined' && preselectTherapist) ? 'open' : '' %>>
            <summary>Prefer a particular therapist? <span class="muted small">(optional)</span></summary>
            <div class="booking-prefs-body">
              <label>
                Therapist gender
                <select name="gender_pref" id="gender-pref-select">
                  <option value="">No preference</option>
                  <option value="female">Female therapist</option>
                  <option value="male">Male therapist</option>
                </select>
              </label>

              <label>
                Therapist
                <select name="therapist_id" id="therapist-select">
                  <option value="">No preference</option>
                  <% therapists.forEach(function(t) { %>
                  <option value="<%= t.id %>" data-gender="<%= t.gender %>"
                    <%= (typeof preselectTherapist !== 'undefined' && String(preselectTherapist) === String(t.id)) ? 'selected' : '' %>>
                    <%= t.name %> (<%= t.gender === 'male' ? 'M' : 'F' %>) — <%= t.specialties %>
                  </option>
                  <% }); %>
                </select>
              </label>

              <!-- Second therapist — only shown for Four Hands (script.js) -->
              <div id="therapist2-container" style="display: none;">
                <label>
                  Second therapist <span class="muted small">(for Four Hands)</span>
                  <select name="therapist2_id" id="therapist2-select">
                    <option value="">No preference</option>
                    <% therapists.forEach(function(t) { %>
                    <option value="<%= t.id %>" data-gender="<%= t.gender %>">
                      <%= t.name %> (<%= t.gender === 'male' ? 'M' : 'F' %>) — <%= t.specialties %>
                    </option>
                    <% }); %>
                  </select>
                </label>
              </div>
            </div>
          </details>

          <%# When a therapist charges their own rate, show it the moment they
              are chosen — the price on screen is the price charged, and it is
              locked to the booking so the menu changing later cannot move it. %>
          <p id="therapist-price-note" class="muted small"
             style="display:none; background:#f6faf9; border-left:4px solid var(--brand,#1f6f78); border-radius:8px; padding:.6rem .8rem; margin:-.4rem 0 1rem;"></p>
          <script>
            window.JM_THERAPIST_PRICES = <%- JSON.stringify(typeof therapistPrices !== 'undefined' ? therapistPrices : {}) %>;
          </script>

          <!-- 2) Date ------------------------------------------------------- -->
          <label>
            <span class="step-label"><span class="step-num">2</span> Pick a date</span>
            <input type="date" name="date" id="date-input" required />
          </label>

          <!-- 3) Time -------------------------------------------------------
               script.js keeps this visible at all times: when a service or date
               is still missing it renders a hint here instead of failing
               silently, which is what used to happen. -->
          <div id="slots-container" style="display:none;">
            <p class="step-label small" style="font-weight:700; margin-bottom:.5rem;">
              <span class="step-num">3</span> Pick a time
            </p>
            <div id="slots-grid" class="slots-grid" aria-live="polite"></div>
            <input type="hidden" name="time" id="time-input" required />
          </div>

          <% if (addons.length > 0) { %>
          <fieldset class="addons-fieldset">
            <legend style="font-weight: 700;">Add-Ons <span class="muted small">(optional)</span></legend>
            <div style="display: flex; flex-wrap: wrap; gap: .8rem;">
              <% addons.forEach(function(a) { %>
              <label style="display: inline-flex; align-items: center; gap: .4rem; font-weight: normal; min-width: 200px;">
                <input type="checkbox" name="addon_ids" value="<%= a.id %>" />
                <%= a.name %> (+<%= fmt.money(a.price) %>)
                <% if (a.description) { %><span class="muted small">— <%= a.description %></span><% } %>
              </label>
              <% }); %>
            </div>
          </fieldset>
          <% } %>

          <!-- 4) Phone ------------------------------------------------------
               The only piece of personal data we require. Asked last, once the
               client has already seen what they're getting and when. -->
          <label>
            <span class="step-label"><span class="step-num">4</span> Your phone number</span>
            <input type="tel" name="client_phone" id="client-phone" placeholder="(555) 555-5555" required />
          </label>

          <!-- SMS consent disclosure. Required evidence of opt-in for A2P 10DLC
               carrier registration — reviewers check that this is live on the site. -->
          <p class="muted small" style="margin: -.4rem 0 1rem; line-height: 1.5;">
            By providing your phone number and booking, you agree to receive appointment
            confirmations and reminders by text message from
            <%# Fallback is plain text — the output tag escapes it, so an HTML
                entity written here would show up literally as "J&amp;M". %>
            <%= settings.spa_name || 'J&M Serenity Spa' %>. Message frequency varies.
            Message and data rates may apply. Reply <strong>STOP</strong> to opt out or
            <strong>HELP</strong> for help. See our
            <a href="/policies#text-messages">Text Message Policy</a>.
          </p>


          <label>
            Your name <span class="muted small">(optional)</span>
            <input type="text" name="client_name" id="client-name" placeholder="Full name" />
          </label>

          <label>
            Email <span class="muted small">(optional — only if you'd like a written confirmation)</span>
            <input type="email" name="client_email" id="client-email" placeholder="you@example.com" />
          </label>

          <!-- Replaces the old "Areas to focus on" + "Notes for therapist"
               fields. Health details belong in the in-spa check-in intake, not
               in a public form that stores them on our own hardware. -->
          <p class="muted small" style="margin: -.2rem 0 .6rem;">
            Tell your therapist about anything they should know when you arrive.
          </p>

          <button class="btn btn-primary btn-block" type="submit" id="submit-btn" disabled>
            Select a time to continue
          </button>
        </form>
      </div>

      <%# Waitlist — for the case the booking form cannot serve: the day is full,
          or the client wants a time that isn't offered. POST /waitlist and the
          success banner above already existed; this form is what feeds them.
          Entries land in the front desk's "Waiting / Walk-Ins" panel, where
          staff can reply by TEXT rather than having to phone anyone in English. %>
      <details class="card reveal" id="waitlist-card">
        <summary style="cursor:pointer; font-weight:700; font-size:1.05rem;">
          Don't see the time you want?
        </summary>
        <p class="muted" style="margin:.8rem 0 1rem;">
          Leave your details and we'll text you if that time opens up. This is not
          a booking — you'll hear from us before anything is reserved.
        </p>
        <form class="form" method="POST" action="/waitlist">
          <div class="grid two">
            <label>
              Your name
              <input type="text" name="client_name" required />
            </label>
            <label>
              Mobile number
              <input type="tel" name="client_phone" required placeholder="(303) 555-1234" />
            </label>
          </div>
          <div class="grid two">
            <label>
              Treatment
              <select name="service_id">
                <option value="">— Any treatment —</option>
                <% services.forEach(function(svc) { %>
                <option value="<%= svc.id %>"><%= svc.name %> — <%= fmt.prettyDuration(svc.duration) %></option>
                <% }); %>
              </select>
            </label>
            <label>
              Preferred date
              <input type="date" name="preferred_date" required />
            </label>
          </div>
          <label>
            Preferred time of day <span class="muted small">(optional)</span>
            <input type="text" name="preferred_time" placeholder="e.g. weekday evenings, Saturday morning" />
          </label>
          <p class="muted small" style="margin:-.4rem 0 1rem; line-height:1.5;">
            By giving us your number you agree to receive a text about this request from
            <%= settings.spa_name || 'J&amp;M Serenity Spa' %>. Message and data rates may apply.
            Reply <strong>STOP</strong> to opt out. See our
            <a href="/policies#text-messages">Text Message Policy</a>.
          </p>
          <button class="btn btn-secondary" type="submit">Add me to the waitlist</button>
        </form>
      </details>

      <div class="card reveal">
        <h2>Policies</h2>
        <h3>Cancellation</h3>
        <p class="muted">Please provide at least <strong>24 hours' notice</strong> to cancel or reschedule.</p>

        <h3>Late arrivals</h3>
        <p class="muted">Late arrivals may result in a shortened session to accommodate other clients.</p>

        <h3>Payment</h3>
        <p class="muted">No online payment required. Payment is due at your appointment.</p>
      </div>
    </div>
  </section>
</main>

<%# The returning-client prefill that used to live here called
   /api/client-lookup, which returns a name and email for ANY phone number to
   any anonymous visitor. On a massage spa's public page that also confirms
   whether a given number belongs to a client, which is itself sensitive.
   The convenience is kept where the person is physically present or signed in
   (the lobby kiosk and the front desk); it does not belong on the open web. %>

<%- include('partials/footer') %>
